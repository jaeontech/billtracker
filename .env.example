# Copy this file to .env.local and fill in your Supabase project values.
# Project Settings → API in the Supabase dashboard.
# These are browser-public (the anon key is designed to be exposed); real
# protection comes from Row-Level Security policies. Never put a service-role key here.
VITE_SUPABASE_URL=
VITE_SUPABASE_ANON_KEY=
